# Configuración del backend Django (Etapa 1).
# Copia este archivo a backend/.env y ajusta los valores localmente.
# backend/.env NO se versiona.

# Django
DJANGO_SECRET_KEY=cambia-este-secreto
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=moonblogger
DB_USER=moonblogger
DB_PASSWORD=cambia-esta-contrasena-local
DB_HOST=localhost
DB_PORT=5432
# Modo SSL de la conexión a PostgreSQL ("disable" en local; "require" en Supabase).
DB_SSLMODE=disable

# CORS (orígenes permitidos para la web en desarrollo)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Producción (Render + Supabase):
# - DJANGO_DEBUG=false: entonces DJANGO_SECRET_KEY es obligatoria (el backend
#   falla al arrancar si falta, fail-fast).
# - ALLOWED_HOSTS se auto-resuelve en Render: el host público
#   (RENDER_EXTERNAL_HOSTNAME, https://moonblogger-api.onrender.com) se añade
#   automáticamente al arrancar; DJANGO_ALLOWED_HOSTS queda para dominios
#   adicionales (p. ej. un dominio personalizado).
# - DB_* son las de Supabase: DB_HOST=<project-ref>.pooler.supabase.com,
#   DB_USER=postgres.<project-ref>, DB_PORT=5432, DB_SSLMODE=require.
# - CORS_ALLOWED_ORIGINS debe incluir el origen https://moonblogger-api.onrender.com
#   y el origen de la web desplegada.
#
# Para operar el backend contra la BD de producción desde esta máquina
# (migrate, create_moon_user, scripts), crea un archivo backend/.env.supabase
# (NO versionado) con las claves DB_* de producción (incluyendo DB_SSLMODE)
# y cárgalo en el shell: `set -a && source backend/.env.supabase && set +a`.
# Por cómo carga el backend (load_dotenv sin override), esos valores ganan
# sobre backend/.env sin modificarlo.
