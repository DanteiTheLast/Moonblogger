# URL base de la API pública de Django (sin barra final).
# Se lee durante el build para pre-renderizar (SSG).
# NO usar NEXT_PUBLIC_: en v1 no hay fetching en el cliente.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# URL pública del sitio (sin barra final).
# Se lee durante el build (server-side) para generar el sitemap y el robots.txt.
# NO usar NEXT_PUBLIC_: solo se usa en build para archivos estáticos.
SITE_URL=http://localhost:3000
