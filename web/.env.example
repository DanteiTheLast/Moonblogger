# URL base de la API pública de Django (sin barra final).
# Se usa en server components durante el build y la revalidación ISR.
# NO usar NEXT_PUBLIC_: en v1 no hay fetching en el cliente.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# URL pública del sitio (sin barra final).
# Se usa en el servidor para generar el sitemap y el robots.txt.
# NO usar NEXT_PUBLIC_: no hay fetching en el cliente en v1.
SITE_URL=http://localhost:3000

# Secreto compartido con WEB_REVALIDATE_SECRET en Render. El backend envía su
# SHA-256 en X-Revalidate-Secret para invalidar la caché ISR.
REVALIDATE_SECRET=cambia-este-secreto-local

# Secreto compartido con el endpoint interno de visitas del backend.
VISIT_FORWARDING_SECRET=cambia-este-secreto-local

# Opcional: email real de contacto mostrado en la página de privacidad.
# PRIVACY_CONTACT_EMAIL=privacidad@tu-dominio.example
